rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwnedDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function preservesOwner() {
      return request.resource.data.userId == resource.data.userId;
    }

    match /figures/{figureId} {
      allow read: if resource.data.visibility == 'public' || ownsExistingDocument();
      allow create: if createsOwnedDocument();
      allow update: if ownsExistingDocument() && preservesOwner();
      allow delete: if ownsExistingDocument();
    }

    match /wishlist/{itemId} {
      allow read: if ownsExistingDocument();
      allow create: if createsOwnedDocument();
      allow update: if ownsExistingDocument() && preservesOwner();
      allow delete: if ownsExistingDocument();
    }

    match /preorders/{preorderId} {
      allow read: if ownsExistingDocument();
      allow create: if createsOwnedDocument();
      allow update: if ownsExistingDocument() && preservesOwner();
      allow delete: if ownsExistingDocument();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
